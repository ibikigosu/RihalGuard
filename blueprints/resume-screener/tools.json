{
  "$schema": "../../schema/tool-manifest-v1.schema.json",
  "manifest_version": "1.0.0",
  "tools": [
    {
      "name": "get_requisition",
      "version": "0.1.0",
      "description": "Load one approved requisition with stable required and preferred qualification identifiers.",
      "risk": "read_or_transform",
      "authority": "read",
      "data_classes": [
        "job_requisition"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "requisition_id": {
            "type": "string"
          }
        },
        "required": [
          "requisition_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_resume",
      "version": "0.1.0",
      "description": "Retrieve one task-scoped resume from an approved source.",
      "risk": "read_or_transform",
      "authority": "read",
      "data_classes": [
        "resume",
        "candidate_personal_data",
        "employment_history",
        "education_history"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "candidate_record_id": {
            "type": "string"
          }
        },
        "required": [
          "candidate_record_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "parse_resume",
      "version": "0.1.0",
      "description": "Structure job-relevant skills, roles, durations, credentials, and accomplishments without evaluating them.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "resume",
        "candidate_personal_data",
        "employment_history",
        "education_history"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "resume_text": {
            "type": "string"
          }
        },
        "required": [
          "resume_text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "redact_protected_attributes",
      "version": "0.1.0",
      "description": "Remove protected characteristics and proxy signals before requirement matching.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "resume",
        "candidate_personal_data",
        "employment_history",
        "education_history"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "parsed_resume": {
            "type": "object"
          }
        },
        "required": [
          "parsed_resume"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "match_requirements",
      "version": "0.1.0",
      "description": "Compare redacted job-relevant evidence with each approved requirement and return met, not_met, or unclear.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "job_requisition",
        "employment_history",
        "education_history"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "requirements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "redacted_resume": {
            "type": "object"
          }
        },
        "required": [
          "requirements",
          "redacted_resume"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "cite_evidence",
      "version": "0.1.0",
      "description": "Attach the smallest useful resume excerpt and source location to a requirement finding.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "resume",
        "employment_history",
        "education_history"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "finding": {
            "type": "object"
          }
        },
        "required": [
          "requirement_id",
          "finding"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_fairness",
      "version": "0.1.0",
      "description": "Verify that findings use only approved job criteria and exclude protected characteristics and proxy signals.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "job_requisition",
        "assessment_metadata"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "findings"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "build_assessment",
      "version": "0.1.0",
      "description": "Build a non-binding structured assessment with requirement findings and interview focus areas.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "job_requisition",
        "employment_history",
        "education_history",
        "assessment_metadata"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fairness_check": {
            "type": "object"
          }
        },
        "required": [
          "findings",
          "fairness_check"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "flag_for_review",
      "version": "0.1.0",
      "description": "Add a review reason to the output without sending or mutating an external record.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "assessment_metadata"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "emit_json",
      "version": "0.1.0",
      "description": "Return the final structured assessment to the caller for recruiter review.",
      "risk": "read_or_transform",
      "authority": "transform",
      "data_classes": [
        "assessment_metadata"
      ],
      "external_side_effects": false,
      "reversibility": "not_applicable",
      "approval": "not_required",
      "audit_required": true,
      "owner": "rihalguard-blueprint-maintainers",
      "allowed_agent_scopes": [
        "resume-screener"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "assessment": {
            "type": "object"
          }
        },
        "required": [
          "assessment"
        ],
        "additionalProperties": false
      }
    }
  ]
}
