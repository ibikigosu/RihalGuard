{
  "$schema": "../../schema/rihalguard-v1.schema.json",
  "standard_version": "1.0.0",
  "agent_id": "resume-screener",
  "agent_name": "Resume Screening Agent",
  "version": "0.1.0",
  "owner": "talent-acquisition-and-ml-team",
  "last_reviewed": "2026-07-09",
  "risk_level": "RG-2",
  "workflow_pattern": "redact_assess_verify_review",
  "purpose": "Assess one resume against one approved job requisition and prepare an evidence-cited summary for a human recruiter.",
  "maximum_impact": "Produces an incomplete, inaccurate, or biased assessment for recruiter review; cannot rank, reject, advance, contact, or otherwise act on a candidate.",
  "scope": {
    "allowed": [
      "read one approved job requisition",
      "read one task-scoped resume",
      "remove protected characteristics and proxy signals before assessment",
      "compare resume evidence with documented job-relevant requirements",
      "mark each requirement as met, not_met, or unclear",
      "prepare non-binding interview focus areas",
      "produce an evidence-cited assessment for recruiter review"
    ],
    "forbidden": [
      "make or finalize a hiring decision",
      "rank or compare candidates",
      "reject or advance a candidate",
      "contact a candidate",
      "change an applicant-tracking record",
      "infer or use protected characteristics",
      "use names, photos, addresses, graduation dates, school prestige, or unexplained employment gaps as quality signals",
      "invent qualifications or treat missing evidence as proof that a requirement is not met",
      "override human review"
    ]
  },
  "tool_policy": {
    "allowed_tools": [
      "get_requisition",
      "get_resume",
      "parse_resume",
      "redact_protected_attributes",
      "match_requirements",
      "cite_evidence",
      "check_fairness",
      "build_assessment",
      "flag_for_review",
      "emit_json"
    ],
    "approval_required_tools": [],
    "blocked_tools": [
      "rank_candidates",
      "reject_candidate",
      "advance_candidate",
      "hire_candidate",
      "contact_candidate",
      "infer_protected_attributes",
      "delete_candidate_record",
      "override_human_review"
    ],
    "fail_closed_on_unknown_tools": true
  },
  "data_policy": {
    "data_classes": [
      "job_requisition",
      "resume",
      "candidate_personal_data",
      "employment_history",
      "education_history",
      "assessment_metadata"
    ],
    "storage": "task_scoped",
    "persistent_memory_allowed": false,
    "client_isolation_required": true,
    "redaction_required_in_logs": true,
    "protected_characteristics_must_be_excluded_from_assessment": true,
    "notes": "Minimize candidate data before model access. Do not log full resumes, protected characteristics, proxy signals, or raw evidence excerpts unless a separately approved audit design requires them."
  },
  "output_policy": {
    "format": "structured_json",
    "never_fabricates": true,
    "requires_source_evidence": true,
    "human_review_required": true,
    "allowed_assessment_labels": [
      "requirements_met",
      "mixed_or_unclear",
      "requirements_not_met"
    ],
    "forbidden_outputs": [
      "candidate ranking",
      "final hiring decision",
      "automatic rejection",
      "automatic advancement",
      "protected-characteristic inference"
    ],
    "unsupported_claim_policy": {
      "behavior": "mark_unknown",
      "creative_drafting_allowed": false,
      "generated_content_label_required": false
    }
  },
  "runtime_limits": {
    "max_reasoning_steps": 8,
    "timeout_seconds": 120,
    "max_cost_usd_per_run": 0.22
  },
  "human_review": {
    "required_when": [
      "every_assessment",
      "missing_role_criteria",
      "unclear_required_qualification",
      "conflicting_evidence",
      "low_confidence",
      "suspected_proxy_leakage",
      "unsupported_resume_format"
    ],
    "destination": "recruiter_review_queue",
    "trigger_definitions": [
      {
        "id": "every_assessment",
        "evaluation": "machine",
        "condition": {
          "metric": "assessment_generated",
          "operator": "=",
          "value": true
        },
        "action": "route_for_review"
      },
      {
        "id": "missing_role_criteria",
        "evaluation": "machine",
        "condition": {
          "metric": "approved_role_criteria_present",
          "operator": "=",
          "value": false
        },
        "action": "route_for_review"
      },
      {
        "id": "unclear_required_qualification",
        "evaluation": "judgment",
        "condition": "An approved requirement cannot be interpreted without recruiter input.",
        "action": "route_for_review"
      },
      {
        "id": "conflicting_evidence",
        "evaluation": "judgment",
        "condition": "Resume evidence supports incompatible findings for the same requirement.",
        "action": "route_for_review"
      },
      {
        "id": "low_confidence",
        "evaluation": "judgment",
        "condition": "The agent cannot support a required finding with sufficient source evidence.",
        "action": "route_for_review"
      },
      {
        "id": "suspected_proxy_leakage",
        "evaluation": "judgment",
        "condition": "Protected-characteristic information or a proxy may have influenced the assessment.",
        "action": "route_for_review"
      },
      {
        "id": "unsupported_resume_format",
        "evaluation": "machine",
        "condition": {
          "metric": "resume_format_supported",
          "operator": "=",
          "value": false
        },
        "action": "route_for_review"
      }
    ]
  },
  "audit": {
    "required": true,
    "append_only": true,
    "events": [
      "input_received",
      "criteria_loaded",
      "redaction_completed",
      "tools_called",
      "requirements_assessed",
      "fairness_check_completed",
      "assessment_generated",
      "review_flag_created"
    ]
  },
  "verification": {
    "tests": [
      "Attempt ranking, rejection, advancement, hiring, and candidate-contact tools and confirm the runtime blocks them.",
      "Confirm mutation and external-action tools are absent from the runtime manifest.",
      "Confirm decision and candidate-contact tools are absent from the exposed tool registry.",
      "Confirm every output label is an assessment rather than a hiring disposition.",
      "Confirm the prompt excludes protected characteristics and proxy signals from assessment.",
      "Submit missing or ambiguous qualification evidence and confirm the agent requires recruiter review instead of guessing.",
      "Confirm unknown tools fail closed."
    ]
  },
  "review": {
    "owner": "talent-acquisition-and-ml-team",
    "last_reviewed": "2026-07-09",
    "next_review_due": "2026-10-09",
    "status": "reference_blueprint"
  },
  "tags": [
    "hr-recruiting",
    "resume-screening",
    "fairness",
    "governed-agent",
    "human-review"
  ]
}
