{
  "$schema": "../../schema/rihalguard-v1.schema.json",
  "standard_version": "1.0.0",
  "agent_id": "action-item-tracker",
  "agent_name": "Action Item Tracking Agent",
  "version": "0.1.0",
  "owner": "workplace-productivity-team",
  "last_reviewed": "2026-06-30",
  "risk_level": "RG-2",
  "workflow_pattern": "extract_track_review",
  "purpose": "Identify agreed action items and prepare reviewable follow-up records.",
  "maximum_impact": "Records a wrong action item for owner correction; cannot notify, assign, close, or create external tasks without approval.",
  "scope": {
    "allowed": [
      "read notes",
      "extract explicit commitments",
      "mark ambiguous ownership",
      "draft follow-up records"
    ],
    "forbidden": [
      "auto-assign people",
      "send reminders",
      "close tasks",
      "invent owners or deadlines"
    ]
  },
  "tool_policy": {
    "allowed_tools": [
      "get_notes",
      "extract_items",
      "resolve_owner",
      "flag_ambiguous",
      "draft_followup",
      "emit_json"
    ],
    "approval_required_tools": [],
    "blocked_tools": [
      "delete_records",
      "approve_payment",
      "change_permissions",
      "publish_externally",
      "override_human_review"
    ],
    "fail_closed_on_unknown_tools": true
  },
  "data_policy": {
    "data_classes": [
      "meeting_notes",
      "employee_data",
      "task_metadata"
    ],
    "storage": "task_scoped",
    "persistent_memory_allowed": false,
    "client_isolation_required": true,
    "redaction_required_in_logs": true,
    "notes": "Do not store sensitive source content in persistent memory. Logs should contain identifiers, decisions, confidence, and review status, not full private content unless explicitly approved."
  },
  "output_policy": {
    "format": "structured_json",
    "never_fabricates": true,
    "requires_source_evidence": true,
    "unsupported_claim_policy": {
      "behavior": "mark_unknown",
      "creative_drafting_allowed": false,
      "generated_content_label_required": false
    }
  },
  "runtime_limits": {
    "max_reasoning_steps": 8,
    "timeout_seconds": 120,
    "max_cost_usd_per_run": 0.25
  },
  "human_review": {
    "required_when": [
      "unclear_ownership",
      "missing_due_date",
      "tentative_commitment",
      "conflicting_status"
    ],
    "destination": "human_review_queue",
    "trigger_definitions": [
      {
        "id": "unclear_ownership",
        "evaluation": "judgment",
        "condition": "The source does not explicitly identify one accountable owner.",
        "action": "route_for_review"
      },
      {
        "id": "missing_due_date",
        "evaluation": "machine",
        "condition": {
          "metric": "due_date_present",
          "operator": "=",
          "value": false
        },
        "action": "route_for_review"
      },
      {
        "id": "tentative_commitment",
        "evaluation": "judgment",
        "condition": "The source describes a possible action but not an explicit commitment.",
        "action": "route_for_review"
      },
      {
        "id": "conflicting_status",
        "evaluation": "judgment",
        "condition": "The available evidence gives incompatible statuses for the same item.",
        "action": "route_for_review"
      }
    ]
  },
  "audit": {
    "required": true,
    "append_only": true,
    "events": [
      "input_received",
      "tools_called",
      "output_generated",
      "review_flag_created"
    ]
  },
  "verification": {
    "tests": [
      "Attempt a blocked tool and confirm the runtime refuses execution.",
      "Confirm mutation and external-action tools are absent from the runtime manifest.",
      "Submit ambiguous or incomplete input and confirm the agent flags uncertainty instead of inventing facts."
    ]
  },
  "review": {
    "owner": "ml-team",
    "last_reviewed": "2026-06-30",
    "next_review_due": "2026-09-30",
    "status": "reference_blueprint"
  },
  "tags": [
    "workplace-productivity",
    "enterprise-automation",
    "governed-agent",
    "human-review"
  ]
}
